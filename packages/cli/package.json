{
  "name": "agentroom",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "bin": {
    "agentroom": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agentroom/mcp": "workspace:*",
    "@agentroom/protocol": "workspace:*"
  },
  "devDependencies": {
    "@agentroom/relay-node": "workspace:*"
  }
}
