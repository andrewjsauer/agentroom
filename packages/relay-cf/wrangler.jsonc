{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentroom-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-12",
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // WebSocket upgrades per client address (CF-Connecting-IP), counted per Cloudflare location.
  // `period` must be 10 or 60 seconds. Over the limit the Worker answers HTTP 429.
  "ratelimits": [
    {
      "name": "UPGRADE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "vars": {
    "IDLE_TTL_SEC": "28800",
    "MAX_AGE_SEC": "86400",
    "BUFFER_SIZE": "500",
    "MAX_MEMBERS": "8",
    "MAX_ROOM_CONNS_PER_IP": "10",
    "RATE_BURST": "20",
    "RATE_PER_SEC": "2",
    "CLOSE_GRACE_MS": "10000",
    "HELLO_TIMEOUT_MS": "10000",
    "PING_INTERVAL_MS": "30000",
    "MEMBER_IDLE_MS": "120000"
  }
}
